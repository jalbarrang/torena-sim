{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "jsxSingleQuote": false,
  "experimentalSortPackageJson": false,
  "endOfLine": "lf",
  "trailingComma": "none",
  "ignorePatterns": [
    "*.png",
    "*.jpg",
    "*.mdb",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "CHANGELOG.md",
    "src/modules/data/json/**/*.json", // Generated game-extract data (recursive: covers gametora/ etc.)
    "courseeventparams/**", // Extracted course event params — machine-generated, keep upstream formatting
    "scripts/data-extract/vendor/**", // Vendored third-party data — not ours to reformat
    "scripts/data-extract/skill-history.json", // Generated by sync scripts

    ".agents/**",
    ".pi/**",
    // oxfmt owns code only (matches the lint-staged `*.{ts,tsx}` scope). Rust
    // config, GitHub workflows, and docs keep their own canonical formatting.
    "*.toml",
    "*.yml",
    "*.yaml",
    "*.md"
  ]
}
