// Contested field (2..=12 compare) — architectural intent.
//
// The collapse this prevents: an agent "unifying" the two field regimes
// (race-sim's exact-9 and contested-compare's 2..=12) into one constant,
// silently making vacuum the default compare mode,
// or reordering the compare pair in engine params so the trace split silently swaps A and B.
//
// RaceSimField and ContestedField are deliberately DISTINCT sorts: a law
// about one cannot be stated about the other, so "reuse the 9 check for
// contested" (or vice versa) is unstatable.

sort RaceSimField { size: Int }
sort ContestedField { size: Int }

// run_race_sim: the field is exactly 9. Always.
relation race_sim_field_valid(f: RaceSimField)
law race_sim_field_valid(f) {
  f.size == 9
}

// run_contested_compare: 2..=12 compared runners.
relation contested_field_valid(f: ContestedField)
law contested_field_valid(f) {
  2 <= f.size
  f.size <= 12
}

// Mob fill: the user picks a target field size (total gates); real umas fill
// first and the remainder are generated mobs. The engine fill target sent to
// run_contested_compare is never below the real runner count and never above
// the engine ceiling. (The default of 9 preserves the field-composition
// experiment outcome but is a default, not a law.)
sort FillRequest { runnerCount: Int, fillTarget: Int }
relation mob_fill_valid(r: FillRequest)
law mob_fill_valid(r) {
  r.runnerCount <= r.fillTarget
  r.fillTarget <= 12
}

// Compare mode encoding (store/UI): 0 = contested (default), 1 = vacuum (opt-in).
// Vacuum compare accepts any real field (1 primary + 0..=11 context runners per
// isolated race, no mob fill); the invariant that survives is insertion order:
// the primary is inserted first (engine id 0) in each vacuum race, and the TS
// reducer reads only the primary's telemetry. Contested-default lives in store
// DEFAULT_COMPARE_MODE (Hiker has no `or` for a mode disjunction law).
// Batch vacuum engine paths also remain for planner/basin sims outside this intent.
sort VacuumRace { primaryIndex: Int }
relation vacuum_primary_first(r: VacuumRace)
law vacuum_primary_first(r) {
  r.primaryIndex == 0
}

// Engine param ordering: Compare A is inserted first (index 0), B second
// (index 1). The TS trace split keys on this; swapping them silently flips
// every pairwise stat.
sort EngineParamOrder { aIndex: Int, bIndex: Int }
relation pair_insertion_order(o: EngineParamOrder)
law pair_insertion_order(o) {
  o.aIndex == 0
  o.bIndex == 1
}

// Legacy/vacuum snapshot decode: removed-vacuum shares MUST decode to contested
// (mode 0) with a 2-runner field, the closest surviving head-to-head analogue.
sort LegacyDecode { mode: Int, fieldSize: Int }
relation legacy_snapshot_decode(d: LegacyDecode)
law legacy_snapshot_decode(d) {
  d.mode == 0
  d.fieldSize == 2
}
